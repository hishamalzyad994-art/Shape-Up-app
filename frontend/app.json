{
  "expo": {
    "name": "ShapeUp",
    "slug": "shapeup",
    "version": "1.0.14",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shapeup",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.emergent.slimchallenge5de71fad6",
      "buildNumber": "30",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan your meals to estimate calories",
        "NSPhotoLibraryUsageDescription": "Pick food photos to estimate calories",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.shapup.myapp",
      "versionCode": 3,
      "permissions": ["android.permission.CAMERA", "android.permission.READ_MEDIA_IMAGES"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000"
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick food photos to estimate calories",
          "cameraPermission": "Scan your meals to estimate calories"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
